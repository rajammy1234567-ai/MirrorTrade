# ─── Server ───────────────────────────────────────────────
PORT=7000
NODE_ENV=development
# production | development

MONGODB_URI=mongodb://127.0.0.1:27017/mirror_trade
# Atlas example:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/mirror_trade?retryWrites=true&w=majority

# REQUIRED — use a long random string (32+ chars). Never commit real secrets.
JWT_SECRET=change_this_to_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# 64-char hex — openssl rand -hex 32
ENCRYPTION_KEY=

CLIENT_URL=http://localhost:8081
ADMIN_URL=http://localhost:5173
# Comma-separated extra browser origins for production CORS
# CORS_ORIGINS=https://admin.yourdomain.com,https://app.yourdomain.com

# Behind Render / Nginx
# TRUST_PROXY=1

# ─── Deposits (BNB → USDT) ────────────────────────────────
# Real company receive address (BSC BEP-20)
BNB_DEPOSIT_ADDRESS=0xYourCompanyBnbAddressHere
BNB_NETWORK=BSC (BEP-20)
BNB_TO_USDT_RATE=600
MIN_DEPOSIT_USDT=10
MAX_DEPOSIT_USDT=100000
MIN_WITHDRAW_USDT=10

# NEVER true in production. Auto-credits deposits without chain proof (dev only).
AUTO_CREDIT_DEPOSITS=false

# Allow demo OTP / auto features when NODE_ENV=production (keep false)
ALLOW_DEMO_FEATURES=false

# ─── Referral ─────────────────────────────────────────────
REFERRAL_REWARD_AMOUNT=50
REFERRAL_MAX_PER_CODE_PER_DAY=20
REFERRAL_INVITE_BASE_URL=https://mirrortrade.app/signup

# ─── Razorpay (optional legacy path) ──────────────────────
# Prefer BNB wallet deposits for the primary product path.
ALLOW_FREE_DEPOSIT=false
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here
RAZORPAY_COMPANY_NAME=MirrorTrade
